#include "keys_sv.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        Layer_Hold_Tap: Layer_Hold_Tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };

        Hold_Tap_KP: Hold_Tap_KP {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        Layer2 {
            bindings = <&mo 2>;
            key-positions = <37 38>;
        };
    };

    macros {
        Change_Q: Change_Q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SV_E)>;
            label = "CHANGE_Q";
        };

        terminal: terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(W)>;
            label = "TERMINAL";
        };

        Column_Search: Column_Search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LEFT_ALT &kp SV_D>;
            label = "COLUMN_SEARCH";
        };

        xml_formatting: xml_formatting {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_SHIFT &kp LEFT_ALT &kp B>;
            label = "XML_FORMATTING";
        };

        // "Vänligen återkom med resultat."
        phSV: phSV {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(V) &kp SV_A_UMLAUT &kp N &kp L &kp I &kp G &kp E &kp N
                        &kp SPACE
                        &kp SV_A_RING &kp T &kp E &kp R &kp K &kp O &kp M
                        &kp SPACE
                        &kp M &kp E &kp D
                        &kp SPACE
                        &kp R &kp E &kp S &kp U &kp L &kp T &kp A &kp T &kp SV_PERIOD>;
            label = "PH_SV";
        };

        // "Please get back to me with the results."
        phEN: phEN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(P) &kp L &kp E &kp A &kp S &kp E
                        &kp SPACE
                        &kp G &kp E &kp T
                        &kp SPACE
                        &kp B &kp A &kp C &kp K
                        &kp SPACE
                        &kp T &kp O
                        &kp SPACE
                        &kp M &kp E
                        &kp SPACE
                        &kp W &kp I &kp T &kp H
                        &kp SPACE
                        &kp T &kp H &kp E
                        &kp SPACE
                        &kp R &kp E &kp S &kp U &kp L &kp T &kp S &kp SV_PERIOD>;
            label = "PH_EN";
                };

        open_cmd: open_cmd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings
                = <&macro_tap &kp LG(R)>
                , <&macro_wait_time 700>
                , <&macro_tap &kp C &kp M &kp D &kp ENTER>;
            label = "OPEN_CMD";
        };

        open_ps: open_ps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <5>;
            tap-ms = <5>;
            bindings
                = <&macro_tap &kp LG(R)>
                , <&macro_wait_time 700>
                , <&macro_tap &kp P &kp O &kp W &kp E &kp R &kp S &kp H &kp E &kp L &kp L &kp ENTER>;
            label = "OPEN_PS";
        };

        // "Looking into this, I will get back to you shortly."
        ph_look_en: ph_look_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(L) &kp O &kp O &kp K &kp I &kp N &kp G
                        &kp SPACE &kp I &kp N &kp T &kp O
                        &kp SPACE &kp T &kp H &kp I &kp S &kp COMMA
                        &kp SPACE &kp I
                        &kp SPACE &kp W &kp I &kp L &kp L
                        &kp SPACE &kp G &kp E &kp T
                        &kp SPACE &kp B &kp A &kp C &kp K
                        &kp SPACE &kp T &kp O
                        &kp SPACE &kp Y &kp O &kp U
                        &kp SPACE &kp S &kp H &kp O &kp R &kp T &kp L &kp Y &kp SV_PERIOD>;
            label = "PH_LOOK_EN";
        };

        // "Could you please provide more details?"
        ph_det_en: ph_det_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(C) &kp O &kp U &kp L &kp D
                        &kp SPACE &kp Y &kp O &kp U
                        &kp SPACE &kp P &kp L &kp E &kp A &kp S &kp E
                        &kp SPACE &kp P &kp R &kp O &kp V &kp I &kp D &kp E
                        &kp SPACE &kp M &kp O &kp R &kp E
                        &kp SPACE &kp D &kp E &kp T &kp A &kp I &kp L &kp S &kp SV_QUESTION>;
            label = "PH_DET_EN";
        };

        // "The issue has been resolved. Please let us know if anything comes up."
        ph_res_en: ph_res_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(T) &kp H &kp E
                        &kp SPACE &kp I &kp S &kp S &kp U &kp E
                        &kp SPACE &kp H &kp A &kp S
                        &kp SPACE &kp B &kp E &kp E &kp N
                        &kp SPACE &kp R &kp E &kp S &kp O &kp L &kp V &kp E &kp D &kp SV_PERIOD
                        &kp SPACE &kp LS(P) &kp L &kp E &kp A &kp S &kp E
                        &kp SPACE &kp L &kp E &kp T
                        &kp SPACE &kp U &kp S
                        &kp SPACE &kp K &kp N &kp O &kp W
                        &kp SPACE &kp I &kp F
                        &kp SPACE &kp A &kp N &kp Y &kp T &kp H &kp I &kp N &kp G
                        &kp SPACE &kp C &kp O &kp M &kp E &kp S
                        &kp SPACE &kp U &kp P &kp SV_PERIOD>;
            label = "PH_RES_EN";
        };

        // "Tittar på detta och återkommer till dig inom kort."
        ph_look_sv: ph_look_sv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(T) &kp I &kp T &kp T &kp A &kp R
                        &kp SPACE &kp P &kp SV_A_RING
                        &kp SPACE &kp D &kp E &kp T &kp T &kp A
                        &kp SPACE &kp O &kp C &kp H
                        &kp SPACE &kp SV_A_RING &kp T &kp E &kp R &kp K &kp O &kp M &kp M &kp E &kp R
                        &kp SPACE &kp T &kp I &kp L &kp L
                        &kp SPACE &kp D &kp I &kp G
                        &kp SPACE &kp I &kp N &kp O &kp M
                        &kp SPACE &kp K &kp O &kp R &kp T &kp SV_PERIOD>;
            label = "PH_LOOK_SV";
        };

        // "Kan du ge mer detaljer om problemet?"
        ph_det_sv: ph_det_sv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(K) &kp A &kp N
                        &kp SPACE &kp D &kp U
                        &kp SPACE &kp G &kp E
                        &kp SPACE &kp M &kp E &kp R
                        &kp SPACE &kp D &kp E &kp T &kp A &kp L &kp J &kp E &kp R
                        &kp SPACE &kp O &kp M
                        &kp SPACE &kp P &kp R &kp O &kp B &kp L &kp E &kp M &kp E &kp T &kp SV_QUESTION>;
            label = "PH_DET_SV";
        };

        // "Ärendet är nu löst. Hör av dig om något annat uppstår."
        ph_res_sv: ph_res_sv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(SV_A_UMLAUT) &kp R &kp E &kp N &kp D &kp E &kp T
                        &kp SPACE &kp SV_A_UMLAUT &kp R
                        &kp SPACE &kp N &kp U
                        &kp SPACE &kp L &kp SV_O_UMLAUT &kp S &kp T &kp SV_PERIOD
                        &kp SPACE &kp LS(H) &kp SV_O_UMLAUT &kp R
                        &kp SPACE &kp A &kp V
                        &kp SPACE &kp D &kp I &kp G
                        &kp SPACE &kp O &kp M
                        &kp SPACE &kp N &kp SV_A_RING &kp G &kp O &kp T
                        &kp SPACE &kp A &kp N &kp N &kp A &kp T
                        &kp SPACE &kp U &kp P &kp P &kp S &kp T &kp SV_A_RING &kp R &kp SV_PERIOD>;
            label = "PH_RES_SV";
        };        
    };

    keymap {
        compatible = "zmk,keymap";

        Base_Layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  | / \ | ' " |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT | PHR |
            //
            // / \  = tap for /  (SV_SLASH), hold for \  (SV_BSLH)
            // PHR (purple, right outer thumb) = sticky layer 4: tap it, then tap a phrase key.

            bindings = <
&Hold_Tap_KP TAB ESC  &kp Q  &kp W         &kp E     &kp R  &kp T        &kp Y                     &kp U                        &kp I      &kp O    &kp P                          &Hold_Tap_KP SV_QUESTION SV_A_RING
&kp LEFT_SHIFT        &kp A  &kp S         &kp D     &kp F  &kp G        &kp H                     &kp J                        &kp K      &kp L    &kp SV_O_UMLAUT                &kp SV_A_UMLAUT
&kp LEFT_CONTROL      &kp Z  &kp X         &kp C     &kp V  &kp B        &kp N                     &kp M                        &kp COMMA  &kp DOT  &Hold_Tap_KP SV_BSLH SV_SLASH  &Hold_Tap_KP SV_DQT NON_US_HASH
                             &kp LEFT_ALT  &kp LGUI  &mo 1  &kp SPACE    &Hold_Tap_KP LSHFT ENTER  &Layer_Hold_Tap 2 BACKSPACE  &mo 3      &sl 4
            >;
        };

        Symbols_Numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | N0  |  @  | ALT |

            bindings = <
&kp TAB           &kp SV_EXCL          &kp SV_DQT           &kp SV_POUND          &kp SV_DOLLAR            &kp SV_PERCENT              &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans         &Hold_Tap_KP SV_PLUS SV_EQUAL       &kp DELETE
&kp LEFT_SHIFT    &kp SV_AMPERSAND     &kp SV_SLASH         &kp SV_AT             &kp SV_LEFT_PARENTHESIS  &kp SV_RIGHT_PARENTHESIS    &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans         &Hold_Tap_KP SV_UNDERSCORE SV_MINUS &kp SV_BSLH
&kp SV_LESS_THAN  &kp SV_GREATER_THAN  &kp SV_LEFT_BRACKET  &kp SV_RIGHT_BRACKET  &kp SV_LEFT_BRACE        &kp SV_RIGHT_BRACE          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp SV_PERIOD  &kp SV_PIPE                         &kp SV_GRAVE
                                       &none                &kp LGUI              &trans                   &kp SPACE                   &kp KP_N0  &trans  &kp SV_AT_SIGN     &none
            >;
        };

        Functions {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none   &kp F1  &kp F2      &kp F3             &kp F4            &kp F5       &kp F6   &kp F7          &kp F8    &kp F9     &kp F10          &kp F11
&trans  &none   &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &none        &kp INS  &kp HOME        &kp UP    &kp END    &trans           &trans
&none   &none   &kp C_PREV  &kp C_NEXT         &kp C_PLAY_PAUSE  &none        &kp F13  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)
                &none       &kp LGUI           &trans            &kp SPACE    &kp RET  &trans          &trans    &none
            >;
        };

        Email_Phrases {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ö  |  Ä   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
            //                    | GUI | EN  | SV  |   | ENT | RSE | ALT | PHR  |
            //

            bindings = <
&trans  &ph_look_en  &ph_det_en  &ph_res_en  &phEN   &phSV     &kp LG(V)  &kp LG(DOT)      &kp LS(LG(S))  &kp LG(E)        &kp LG(L)   &trans
&trans  &ph_look_sv  &ph_det_sv  &ph_res_sv  &trans  &trans    &kp LG(R)  &open_cmd         &open_ps       &kp LC(LS(ESC))  &kp LG(I)   &trans
&trans  &trans       &trans      &trans      &trans  &trans    &trans     &trans            &trans         &trans           &trans      &trans
                     &trans      &trans      &trans  &trans    &trans     &trans            &trans         &trans
            >;
        };


        BT_Layer {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans           &trans    &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &studio_unlock    &terminal        &Change_Q  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &Column_Search    &xml_formatting  &trans     &trans  &trans  &trans  &trans
                              &trans        &trans        &trans        &trans            &trans           &trans     &trans  &trans
            >;
        };
    };
};
