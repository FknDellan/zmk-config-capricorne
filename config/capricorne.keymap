#include "keys_sv.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        Layer_Hold_Tap: Layer_Hold_Tap {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_TAP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };

        Hold_Tap_KP: Hold_Tap_KP {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_KP";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "balanced";
        };
    };

    combos {
        compatible = "zmk,combos";

        Layer2 {
            bindings = <&mo 2>;
            key-positions = <37 38>;
        };

        refresh {
            bindings = <&kp F5>;
            key-positions = <4 5>;
        };
    };

    macros {
        Change_Q: Change_Q {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(SV_E)>;
            label = "CHANGE_Q";
        };

        openM2: openM2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(A))>;
            label = "OPENM2";
        };

        OpenO2: OpenO2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(LA(O))>;
            label = "OPENO2";
        };

        terminal: terminal {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(W)>;
            label = "TERMINAL";
        };

        Column_Search: Column_Search {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHIFT &kp LEFT_ALT &kp SV_D>;
            label = "COLUMN_SEARCH";
        };

        xml_formatting: xml_formatting {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_SHIFT &kp LEFT_ALT &kp B>;
            label = "XML_FORMATTING";
        };

        // "Vänligen återkom med resultat."
        phSV: phSV {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(V) &kp SV_A_UMLAUT &kp N &kp L &kp I &kp G &kp E &kp N
                        &kp SPACE
                        &kp SV_A_RING &kp T &kp E &kp R &kp K &kp O &kp M
                        &kp SPACE
                        &kp M &kp E &kp D
                        &kp SPACE
                        &kp R &kp E &kp S &kp U &kp L &kp T &kp A &kp T &kp SV_PERIOD>;
            label = "PH_SV";
        };

        // "Please get back to me with the results."
        phEN: phEN {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <2>;
            tap-ms = <2>;
            bindings = <&kp LS(P) &kp L &kp E &kp A &kp S &kp E
                        &kp SPACE
                        &kp G &kp E &kp T
                        &kp SPACE
                        &kp B &kp A &kp C &kp K
                        &kp SPACE
                        &kp T &kp O
                        &kp SPACE
                        &kp M &kp E
                        &kp SPACE
                        &kp W &kp I &kp T &kp H
                        &kp SPACE
                        &kp T &kp H &kp E
                        &kp SPACE
                        &kp R &kp E &kp S &kp U &kp L &kp T &kp S &kp SV_PERIOD>;
            label = "PH_EN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base_Layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT | PHR |
            //
            // PHR (purple, right outer thumb) = sticky layer 4: tap it, then tap a phrase key.

            bindings = <
&Hold_Tap_KP TAB ESC  &kp Q  &kp W         &kp E     &kp R  &kp T        &kp Y                     &kp U                        &kp I      &kp O    &kp P            &Hold_Tap_KP SV_QUESTION SV_A_RING
&kp LEFT_SHIFT        &kp A  &kp S         &kp D     &kp F  &kp G        &kp H                     &kp J                        &kp K      &kp L    &kp SV_O_UMLAUT  &kp SV_A_UMLAUT
&kp LEFT_CONTROL      &kp Z  &kp X         &kp C     &kp V  &kp B        &kp N                     &kp M                        &kp COMMA  &kp DOT  &kp SLASH        &Hold_Tap_KP LS(NON_US_HASH) NON_US_HASH
                             &kp LEFT_ALT  &kp LGUI  &mo 1  &kp SPACE    &Hold_Tap_KP LSHFT ENTER  &Layer_Hold_Tap 2 BACKSPACE  &mo 3      &sl 4
            >;
        };

        Symbols_Numpad {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB           &kp SV_EXCL          &kp SV_DQT           &kp SV_POUND          &kp SV_DOLLAR            &kp SV_PERCENT              &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans         &Hold_Tap_KP SV_PLUS SV_EQUAL  &kp DELETE
&kp LEFT_SHIFT    &kp SV_AMPERSAND     &kp SV_SLASH         &kp SV_AT             &kp SV_LEFT_PARENTHESIS  &kp SV_RIGHT_PARENTHESIS    &kp KP_N4  &kp KP_N5  &kp KP_N6  &trans         &kp SV_UMLAUT                  &kp SV_BSLH
&kp SV_LESS_THAN  &kp SV_GREATER_THAN  &kp SV_LEFT_BRACKET  &kp SV_RIGHT_BRACKET  &kp SV_LEFT_BRACE        &kp SV_RIGHT_BRACE          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp SV_PERIOD  &trans                         &kp SV_GRAVE
                                       &none                &kp LGUI              &trans                   &kp SPACE                   &kp KP_N0  &trans     &trans     &none
            >;
        };

        Functions {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none   &kp F1  &kp F2      &kp F3             &kp F4            &kp F5       &kp F6   &kp F7          &kp F8    &kp F9     &kp F10          &kp F11
&trans  &none   &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &none        &kp INS  &kp HOME        &kp UP    &kp END    &trans           &trans
&none   &none   &kp C_PREV  &kp C_NEXT         &kp C_PLAY_PAUSE  &none        &kp F13  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT  &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)
                &none       &kp LGUI           &kp SV_T          &kp SPACE    &kp RET  &trans          &trans    &none
            >;
        };

        BT_Layer {
            bindings = <
&bt BT_CLR      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &openM2          &OpenO2    &trans  &trans  &trans  &trans
&trans          &trans        &trans        &trans        &trans        &studio_unlock    &terminal        &Change_Q  &trans  &trans  &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &Column_Search    &xml_formatting  &trans     &trans  &trans  &trans  &trans
                              &trans        &trans        &trans        &trans            &trans           &trans     &trans  &trans
            >;
        };

        Email_Phrases {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  Ö  |  Ä   |
            // | CTRL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | ESC  |
            //                    | GUI | EN  | SV  |   | ENT | RSE | ALT | PHR  |
            //
            // L Thumb 3 key (EN) = "Please get back to me with the results."
            // L Thumb 4 key (SV) = "Vänligen återkom med resultat."

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &phEN   &phSV       &trans  &trans  &trans  &trans
            >;
        };
    };
};
